# ========================================
# CONFIGURACIÓN DE REESCRITURA
# ========================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Establecer la base
    RewriteBase /

    # IMPORTANTE: NO redirigir archivos estáticos (CSS, JS, imágenes)
    # Solo redirigir si NO es un archivo físico Y NO es un directorio
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Redirigir solo peticiones que NO sean archivos
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>

# ========================================
# SEGURIDAD: Prevenir acceso a archivos sensibles
# ========================================

<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|sql|md|json|lock|dist|git|env)$">
    Require all denied
</FilesMatch>

# Prevenir acceso a directorios ocultos
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_URI} "!(^|/)\." [NC]
</IfModule>

# ========================================
# HEADERS DE SEGURIDAD
# ========================================

<IfModule mod_headers.c>
    # Prevenir clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # Prevenir MIME sniffing
    Header set X-Content-Type-Options "nosniff"

    # Habilitar XSS Protection
    Header set X-XSS-Protection "1; mode=block"

    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # Permitir CORS para assets (opcional)
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|woff|woff2|ttf|eot)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ========================================
# TIPOS MIME
# ========================================

<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
</IfModule>

# ========================================
# COMPRESIÓN (Performance)
# ========================================

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# ========================================
# CACHE CONTROL
# ========================================

<IfModule mod_expires.c>
    ExpiresActive On

    # Assets estáticos
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"

    # HTML sin cache
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>