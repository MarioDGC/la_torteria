# ========================================
# PROYECTO PHP + JavaScript Vanilla
# Stack: PHP, MySQL, Bootstrap 5
# Compatible: Hostinger, HostGator
# ========================================

# === Configuración sensible (CRÍTICO) ===
config.php
config/database.php
db_config.php
.env
.env.local
.env.*.local
*.key

# === Archivos del sistema ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
*~

# === IDEs y editores ===
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# === PHP ===
/vendor/
composer.lock
composer.phar

# === Node (si usas herramientas de build) ===
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# === Archivos subidos por usuarios ===
storage/uploads/*
!storage/uploads/.gitkeep
/public/uploads/*
!/public/uploads/.gitkeep
/assets/uploads/*
!/assets/uploads/.gitkeep

# === Caché y temporales ===
/cache/*
!/cache/.gitkeep
/tmp/*
!/tmp/.gitkeep
*.cache
*.tmp
*.bak
*~

# === Logs ===
storage/logs/*.log
!storage/logs/.gitkeep
*.log
error_log
php_errors.log

# === Sesiones PHP ===
/sessions/*
!/sessions/.gitkeep

# === Backups de base de datos ===
*.sql
*.sql.gz
*.sql.zip
*.dump
/backups/*
!/backups/.gitkeep
/database/backups/*

# === Archivos de Hostinger ===
.htaccess.backup
php.ini.backup
.well-known/

# === Archivos de HostGator ===
# cPanel y configuración
.cpanel/
.cpcalendars/
.cpaddons/
.contactemail
.lastlogin
.ftpquota
.trash/

# Logs específicos de HostGator
/tmp/error_log
/public_html/error_log
access_log

# Archivos de correo (si usas email hosting)
/mail/
/etc/

# SSL generado automáticamente
/ssl/

# Softaculous (instalador automático de apps)
.softaculous/

# Archivos temporales de cPanel
/.cpanel-datastore/
/cpanel3-skel/

# === Dependencias locales (si no usas CDN) ===
/assets/vendor/
/public/vendor/
/js/vendor/
/css/vendor/

# === Build (si usas preprocesadores) ===
/dist/
/build/